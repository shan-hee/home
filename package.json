{
  "name": "home",
  "author": "imsyy",
  "efua": "NanoRocky",
  "github": "https://github.com/imsyy/home",
  "efug": "https://github.com/NanoRocky/home",
  "home": "https://imsyy.top",
  "efuh": "https://nanorocky.top",
  "private": true,
  "version": "4.3.9.dev [EFU]",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:web": "vite --host",
    "dev:api": "wrangler pages dev public --port 8788",
    "dev:cf": "pnpm run --parallel \"/^dev:(web|api)$/\"",
    "db:migrate:local": "wrangler d1 migrations apply home-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply home-dev --remote",
    "db:seed:generate": "node scripts/generate-local-seed.mjs",
    "db:seed:local": "wrangler d1 execute home-dev --local --file=.tmp/local-seed.sql",
    "db:seed:remote": "wrangler d1 execute home-dev --remote --file=.tmp/local-seed.sql",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write src/",
    "lint": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "package-update": "npx npm-check-updates -u && pnpm update --latest --save"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icon-park/react": "^1.4.2",
    "@iconify/react": "^6.0.2",
    "dayjs": "^1.11.21",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swiper": "^12.2.0",
    "valibot": "^1.4.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "npm-check-updates": "^22.2.3",
    "prettier": "^3.8.4",
    "sass-embedded": "^1.100.0",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "unocss": "^66.7.2",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "glob": "^13.0.6",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.5",
    "source-map@^0.8.0-beta": "0.7.6"
  }
}
