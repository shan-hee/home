# 本地运行配置；生产变量在 Cloudflare Pages 项目设置中定义。
APP_ENV = "development"

# 单所有者登录密码。由所有者设置，至少 8 个字符，不得提交真实值。
OWNER_PASSWORD = ""
# 用于登录限流的 IP 摘要密钥，应使用 `openssl rand -base64 48` 生成。
IP_HASH_SECRET = ""

# 网易云音乐播放地址解析服务密钥；登录 https://api.chksz.com/ 后获取。
CHKSZ_API_KEY = ""

# 可选：中国天气预警。留空时 /api/alerts 返回空数组，不影响普通天气。
QWEATHER_API_KEY = ""
QWEATHER_API_HOST = "devapi.qweather.com"

# 可选：Wallhaven 请求身份；当前仅请求公开 SFW 壁纸，留空即可使用。
WALLHAVEN_API_KEY = ""
